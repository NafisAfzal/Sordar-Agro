# Production environment template. Copy the values into your hosting
# provider's secret manager / environment settings — never commit a real file.
APP_NAME="Sordar Agro"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# --- Database -----------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sordar_agro
DB_USERNAME=sordar_agro
DB_PASSWORD=

# --- Session / proxy ----------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
# Railway terminates TLS at its edge. Keep the app reachable only through
# that edge before trusting forwarded headers.
TRUSTED_PROXIES=*

# --- Cache / queue ------------------------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail ---------------------------------------------------------------
# This project supports Brevo's HTTP API transport.
MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS="hello@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

# --- App specific -------------------------------------------------------
WHATSAPP_NUMBER=8801309985363
PAYMENT_NUMBER=01309985363

# Demo accounts must never be seeded into a real production database.
ALLOW_DEMO_SEED=false
