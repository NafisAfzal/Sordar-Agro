APP_NAME="Sordar Agro"
# Local development defaults are shown below.
# For production, provide these values through the deployment environment instead:
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://your-real-domain.example
#   APP_KEY=<persistent-production-key>   (generate once: php artisan key:generate --show)
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database -----------------------------------------------------------
# Default: MySQL. To use SQLite instead, set DB_CONNECTION=sqlite and
# create the file: touch database/database.sqlite (remove the DB_* lines).
# Production: supply real DB_CONNECTION/DB_HOST/DB_PORT/DB_DATABASE/
# DB_USERNAME/DB_PASSWORD via the deployment environment.
# NEVER commit production database credentials to this repository.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sordar_agro
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Mail (log driver writes "emails" to storage/logs/laravel.log) ------
# MAIL_MAILER=log is for LOCAL DEVELOPMENT ONLY — it silently discards real
# email. Production must configure an actual mail provider (this project has
# used Brevo's HTTP API) with that provider's credentials and sender domain.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@sordaragro.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- App specific -------------------------------------------------------
# WhatsApp number for the floating support button (international format, no +).
WHATSAPP_NUMBER=8801309985363
PAYMENT_NUMBER=01309985363
